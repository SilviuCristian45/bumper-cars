# systemd unit for the Mașinuțe de Bâlci game server, installed by deploy/setup.sh.
# /opt/masinute/current is a symlink to the active release (switched atomically by deploy/push.ps1).
[Unit]
Description=Mașinuțe de Bâlci (Colyseus)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=masinute
Group=masinute
WorkingDirectory=/opt/masinute/current/server
ExecStart=/usr/bin/node /opt/masinute/current/server/index.js
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=2568
Environment=MAX_ROOMS=20
# All-time leaderboard (SQLite, WAL). /var/lib/masinute belongs to the masinute user and lives outside
# /opt/masinute, so deploys and rollbacks never touch it. node:sqlite needs no flag on Node >= 22.13.
StateDirectory=masinute
StateDirectoryMode=0750
Environment=DB_PATH=/var/lib/masinute/leaderboard.db
Restart=always
RestartSec=3

# Shared 1 GB VPS: keep the game in its own small box.
MemoryMax=250M
Environment="NODE_OPTIONS=--max-old-space-size=170 --enable-source-maps"

# Hardening (as bombe.service): the process reads its bundle, writes only its StateDirectory and listens on loopback.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
# More (SECURITY-AUDIT.md, m5). Network only to/from loopback: Caddy connects from 127.0.0.1 and the
# server never needs to reach out, so even a compromised process could not send data anywhere.
IPAddressDeny=any
IPAddressAllow=localhost
CapabilityBoundingSet=
AmbientCapabilities=
ProtectProc=invisible
ProtectHostname=true
ProtectClock=true
ProtectKernelLogs=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
SystemCallArchitectures=native
# A system call outside the usual service set fails with EPERM instead of killing Node.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
# Not MemoryDenyWriteExecute: V8's JIT needs writable+executable memory.

[Install]
WantedBy=multi-user.target
